MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookstore?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Access-token TTL is constrained to 5-60 minutes; sessions have a 7-day absolute cap.
JWT_EXPIRES_IN=15m
# Reset-link lifetime, constrained to 5-60 minutes.
PASSWORD_RESET_LINK_TTL_MINUTES=15
NODE_ENV=development

# Public origins of the separate applications.
# Comma-separated frontend origins are allowed for CORS; the first is used for OAuth redirects and email links.
# Production defaults to https://bookstore-app-8m39.vercel.app when FRONTEND_URL is not set.
FRONTEND_URL=http://localhost:3000
# BACKEND_URL is used for the Google OAuth callback and public asset URLs.
BACKEND_URL=http://localhost:3001

AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
EMAIL_PROVIDER=smtp

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create a Web application OAuth client. Authorized redirect URI:
# http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Gmail SMTP — use an App Password, not your normal Gmail password.
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-gmail-address@gmail.com
EMAIL_FROM=your-gmail-address@gmail.com

# Optional Resend provider (used only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
